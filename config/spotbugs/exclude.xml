<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude GUI package - legacy code, would need major refactoring -->
    <Match>
        <Package name="~gui\..*"/>
    </Match>

    <!-- Exclude test-generated code -->
    <Match>
        <Source name="~.*Test\.java"/>
    </Match>

    <!-- Allow intentional fall-through in switch statements for command parsing -->
    <Match>
        <Class name="~engine\.parser\..*"/>
        <Bug pattern="SF_SWITCH_FALLTHROUGH"/>
    </Match>

    <!-- Scanner uses intentional state machine patterns -->
    <Match>
        <Class name="~engine\.scanner\..*"/>
        <Bug pattern="SF_SWITCH_FALLTHROUGH"/>
    </Match>

    <!-- Allow serialization issues in state classes (not serialized over network) -->
    <Match>
        <Package name="engine.state"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>

    <!-- Machine singleton is intentional design choice -->
    <Match>
        <Class name="engine.Machine"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>
</FindBugsFilter>
