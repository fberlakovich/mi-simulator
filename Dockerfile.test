# Dockerfile for running MI Simulator GUI tests with Xvfb
FROM eclipse-temurin:21-jdk

# Install Xvfb and dependencies for headless GUI testing
RUN apt-get update && apt-get install -y \
    xvfb \
    libxrender1 \
    libxtst6 \
    libxi6 \
    fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy project files (excluding gradle.properties which has macOS paths)
COPY build.gradle settings.gradle gradlew ./
COPY gradle/ gradle/
COPY src/ src/
COPY config/ config/

# Make gradlew executable
RUN chmod +x gradlew

# Pre-download dependencies (without macOS-specific gradle.properties)
RUN ./gradlew dependencies --no-daemon

# Set display for Xvfb
ENV DISPLAY=:99

# Create startup script that runs Xvfb in background then runs tests
# Increase test timeout to 10 minutes for GUI tests
RUN echo '#!/bin/bash\nXvfb :99 -screen 0 1024x768x24 &\nsleep 2\nexec ./gradlew test --no-daemon -PtestTimeout=600 "$@"' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
