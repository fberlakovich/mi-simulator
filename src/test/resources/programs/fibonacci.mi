        SEG
        MOVE W I 10, R0
        MOVE W I 0, R1
        MOVE W I 1, R2
        CMP W I 0, R0
        JEQ done
        CMP W I 1, R0
        JEQ done
        SUB W I 1, R0
loop:   MOVE W R2, R3
        ADD W R1, R3
        MOVE W R2, R1
        MOVE W R3, R2
        SUB W I 1, R0
        JGT loop
done:   HALT
        END
