        SEG
        MOVE W I 1000, R0
        MOVE W I 5, !R0+
        MOVE W I 2, !R0+
        MOVE W I 8, !R0+
        MOVE W I 1, !R0+
        MOVE W I 9, !R0
        MOVE W I 1000, R0
        MOVE W I 5, R1
        MOVE W I 0, R2
outer:  CMP W R2, R1
        JGE done
        MOVE W I 0, R3
        MOVE W R1, R4
        SUB W R2, R4
        SUB W I 1, R4
inner:  CMP W R3, R4
        JGE nextout
        MOVE W R0, R5
        MOVE W R3, R6
        MULT W I 4, R6
        ADD W R6, R5
        MOVE W !R5, R7
        MOVE W 4+!R5, R8
        CMP W R7, R8
        JLE noswp
        MOVE W R8, !R5
        MOVE W R7, 4+!R5
noswp:  ADD W I 1, R3
        JUMP inner
nextout: ADD W I 1, R2
        JUMP outer
done:   HALT
        END
